{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 20,
            "statusMessage": "작업 환경 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-guard.sh\"",
            "timeout": 15,
            "statusMessage": "금지 패턴 검사 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-verification.sh\"",
            "timeout": 15,
            "suppressOutput": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-verify.sh\"",
            "timeout": 30,
            "statusMessage": "완료 조건 검증 확인 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(bash scripts/guard-scan.sh:*)",
      "Bash(bash scripts/arch-check.sh:*)",
      "Bash(bash scripts/secret-scan.sh:*)",
      "Bash(bash scripts/lint-changed.sh:*)",
      "Bash(bash scripts/test-affected.sh:*)",
      "Bash(bash scripts/verify-full.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
