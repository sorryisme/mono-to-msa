<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 콘솔에 로그를 출력하는 설정 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{request_UUID}][%X{method}:%X{uri}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hibernate SQL 로그 설정 (바인딩 값은 개인정보가 섞일 수 있어 켜지 않는다) -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- 전체 로그 설정 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>